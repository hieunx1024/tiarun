import { Theme } from "theme.slint";
import { LiquidGlassLauncher, LauncherItemData } from "launcher.slint";
import { CategoryChip } from "components/chip.slint";

export { Theme, LauncherItemData }

export component AppWindow inherits Window {
    forward-focus: window_focus;
    title: "TiaRun";
    icon: @image-url("../assets/tiarun.png");
    no-frame: true;
    background: transparent;
    width: root.launcher_width;
    height: root.launcher_height;
    in-out property <bool> cfg_enable_shadow_margin: true;
    in-out property <bool> cfg_fixed_width: false;
    property <length> shadow_margin: root.cfg_enable_shadow_margin && root.cfg_view_style == "liquid_glass" && !root.in_settings_mode ? Theme.shadow_margin : 0px;
    property <length> content_height: root.in_settings_mode ? Theme.settings_height :
        (root.is_showing_list ? Theme.panel_height : Theme.pill_height);
    property <length> panel_base_width: root.cfg_fixed_width ? Theme.panel_width :
        ((root.is_showing_list && !root.in_settings_mode) ? Theme.panel_width : Theme.pill_width);
    out property <length> launcher_width: root.panel_base_width + 2 * root.shadow_margin;
    out property <length> launcher_height: root.content_height + root.shadow_margin;
    out property <length> launcher_radius: root.is_showing_list ? Theme.panel_radius : Theme.pill_radius;
    default-font-family: "Noto Sans";
    default-font-size: 19px;

    // File Preview Panel Properties
    in-out property <bool> show_preview: false;
    in property <string> preview_title: "";
    in property <string> preview_type: "none"; // "image" | "text" | "metadata"
    in property <string> preview_lang: "";
    in property <string> preview_text: "";
    in property <string> preview_file_size: "";
    in property <string> preview_file_modified: "";
    in property <string> preview_file_location: "";
    in property <image> preview_image;

    in-out property <string> search_text: "";
    in-out property <int> selected_index: 0;
    in-out property <length> scroll_viewport_y: 0px;
    out property <length> results_height: root.cfg_view_style == "liquid_glass" ?
        glass_launcher.results_height : list_flickable.height;
    in-out property <string> active_category: "";
    in property <bool> categories_enabled: true;
    in property <[string]> categories: ["Applications", "Development", "Browser", "Media", "Office", "System", "Actions"];
    in property <[LauncherItemData]> items: [];
    in property <bool> has_results: true;
    in property <string> mode_title: "APPLICATIONS";
    in property <bool> is_file_mode: false;
    in property <bool> is_shell_mode: false;
    in property <string> mode_badge_text: "";
    in property <string> status_item_count: "0 apps";

    // Dynamic Morphing Spotlight Properties
    in-out property <bool> cfg_compact_empty: true;
    in-out property <bool> is_expanded: false;
    // Pop-in appear animation: a plain fade in place (no position movement), set by
    // Rust right before/after showing the window. See animate_window_pop_in() in
    // main.rs. Kept to opacity only (no x/y animation) since animating position
    // together with the panel's drop-shadow proved to be too heavy for rapid
    // show/hide cycles and crashed the compositor.
    in-out property <bool> is_pop_visible: false;
    in-out property <bool> is_showing_list: root.in_settings_mode
        || root.search_text != ""
        || root.is_expanded
        || root.cfg_fixed_width
        || (!root.cfg_compact_empty && root.cfg_view_style != "liquid_glass");

    // Action Vector Icons
    in property <image> settings_icon;
    in property <image> nav_icon;
    in property <image> enter_icon;
    in property <image> search_icon;
    in property <image> folder_icon;

    // Empty State Properties
    in property <string> empty_state_title: "No applications found";
    in property <string> empty_state_subtitle: "Try searching for an app, file, or math command";
    in property <bool> is_empty_folder: false;

    // In-App Settings State
    in-out property <bool> in_settings_mode: false;
    in-out property <bool> cfg_autostart: false;
    in-out property <bool> cfg_show_icons: true;
    in-out property <bool> cfg_show_status_bar: true;
    in-out property <bool> cfg_enable_path_matching: true;
    in-out property <int> cfg_max_results: 7;
    in-out property <int> cfg_max_depth: 2;
    in-out property <string> cfg_theme_mode: "dark";
    in-out property <float> cfg_theme_opacity: 0.95;
    in-out property <string> cfg_view_style: "liquid_glass";
    in-out property <bool> has_blur: true;
    in-out property <bool> is_dark: false;
    in-out property <string> settings_status: "";
    in-out property <string> active_scope: "apps";
    in property <image> scope_apps_icon;
    in property <image> scope_files_icon;
    in property <image> scope_text_icon;
    in property <image> scope_windows_icon;
    in property <string> action_hint_text: "";
    in property <string> action_item_count: "";

    // Dynamic Theme Color Tokens (Fuzzel Theme)
    property <color> col_card_bg: root.is_dark ? rgba(28, 28, 28, root.cfg_theme_opacity) : rgba(250, 250, 252, root.cfg_theme_opacity);
    property <color> col_border: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_text_primary: root.is_dark ? #c2c0b6 : #1d1d1f;
    property <color> col_text_muted: root.is_dark ? #8e8e93 : #86868b;
    property <color> col_text_placeholder: root.is_dark ? #9ca3af : #4b5563;
    property <color> col_input_text: root.is_dark ? #faf9f5 : #1d1d1f;
    property <color> col_selection_bg: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_selection_text: root.is_dark ? #faf9f5 : #1d1d1f;
    property <color> col_prompt: root.is_dark ? #dedcd1 : #48484a;
    property <color> col_item_hover: root.is_dark ? #2d2d2d80 : #f2f2f780;
    property <color> col_accent: root.is_dark ? #dedcd1 : #007aff;
    property <color> col_item_selected_bg: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_badge_bg: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_badge_text: root.is_dark ? #dedcd1 : #48484a;
    property <color> col_separator: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_kbd_bg: root.is_dark ? #2d2d2d : #f2f2f7;
    property <color> col_kbd_border: root.is_dark ? #38383a : #d1d1d6;
    property <color> col_kbd_text: root.is_dark ? #8e8e93 : #86868b;
    property <color> col_kbd_accent: root.is_dark ? #dedcd1 : #007aff;
    property <color> col_settings_card_bg: root.is_dark ? #222222 : #ffffff;
    property <color> col_settings_card_border: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_settings_card_text: root.is_dark ? #faf9f5 : #1d1d1f;
    property <color> col_btn_secondary_bg: root.is_dark ? #2d2d2d : #f2f2f7;
    property <color> col_btn_secondary_hover: root.is_dark ? #383838 : #e5e5ea;
    property <color> col_btn_secondary_text: root.is_dark ? #faf9f5 : #1d1d1f;

    callback search_text_changed(string);
    callback file_search_finished();
    callback move_up();
    callback move_down();
    callback item_activated(int);
    callback open_in_terminal(int);
    callback copy_path(int);
    callback copy_item(int);
    callback open_config();
    callback close_settings();
    callback save_settings(bool, bool, bool, int, int, bool, bool, string, float, string);
    callback chip_selected(string);
    callback scope_selected(string);
    callback open_raw_config();
    callback close_window();
    callback start_window_drag();
    callback tab_pressed();
    callback backtab_pressed();
    callback handle_backspace() -> bool;
    callback handle_right_arrow() -> bool;
    callback handle_left_arrow() -> bool;
    callback request_system_theme();
    // "!" shell mode command recall (Up/Down), like a real shell's history.
    callback shell_history_prev() -> string;
    callback shell_history_next() -> string;
    callback shell_history_reset();

    public function focus_search() {
        if (root.cfg_view_style == "liquid_glass") {
            glass_launcher.focus_search();
        } else {
            search_input.focus();
        }
    }

    public function move_cursor_to_end() {
        if (root.cfg_view_style == "liquid_glass") {
            glass_launcher.focus_search();
        } else {
            search_input.set-selection-offsets(999999, 999999);
        }
    }

    public function focus_settings() {
        settings_focus.focus();
    }

    public function auto_save_settings() {
        root.save_settings(
            root.cfg_show_icons,
            root.cfg_show_status_bar,
            root.cfg_enable_path_matching,
            root.cfg_max_results,
            root.cfg_max_depth,
            root.cfg_autostart,
            root.cfg_compact_empty,
            root.cfg_theme_mode,
            root.cfg_theme_opacity,
            root.cfg_view_style
        );
    }

    // Programmatically sets the search text (shell history recall, F1 help
    // shortcut, ...) and re-runs the search, exactly as if the user had typed it.
    function set_search_text_and_search(text: string) {
        root.search_text = text;
        root.is_expanded = (text != "");
        root.search_text_changed(text);
    }

    init => {
        Theme.dark = root.is_dark;
        Theme.has_blur = root.has_blur;
        if (root.cfg_view_style == "liquid_glass") {
            glass_launcher.focus_search();
        } else {
            search_input.focus();
        }
    }

    changed is_dark => {
        Theme.dark = root.is_dark;
    }

    changed cfg_theme_opacity => {
        Theme.surface_opacity = root.cfg_theme_opacity;
    }

    changed has_blur => {
        Theme.has_blur = root.has_blur;
    }

    window_focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == "\u{001b}") {
                if (root.in_settings_mode) {
                    root.auto_save_settings();
                    root.close_settings();
                } else {
                    root.close_window();
                }
                return accept;
            }
            return reject;
        }

        if root.shadow_margin > 0px: Rectangle {
        x: root.shadow_margin;
        y: 0px;
        width: root.panel_base_width;
        height: root.content_height;
        border-radius: root.launcher_radius;
        opacity: root.is_pop_visible ? 1.0 : 0.0;
        animate opacity { duration: root.is_pop_visible ? 160ms : 0ms; easing: ease-out; }
        drop-shadow-color: root.is_showing_list ? Theme.shadow_color_panel : Theme.shadow_color_pill;
        drop-shadow-offset-y: 8px;
        drop-shadow-blur: 10px;
    }

    glass_launcher := LiquidGlassLauncher {
        visible: (root.cfg_view_style == "liquid_glass") && !root.in_settings_mode;
        x: root.shadow_margin;
        y: 0px;
        width: root.panel_base_width;
        height: root.content_height;
        active_category <=> root.active_category;
        categories_enabled: root.categories_enabled;
        categories: root.categories;
        search_text <=> root.search_text;
        selected_index <=> root.selected_index;
        scroll_viewport_y <=> root.scroll_viewport_y;
        items: root.items;
        has_results: root.has_results;
        search_icon: root.search_icon;
        settings_icon: root.settings_icon;
        is_expanded: root.is_showing_list;
        is_pop_visible: root.is_pop_visible;
        show_preview: root.show_preview;
        preview_title: root.preview_title;
        preview_type: root.preview_type;
        preview_lang: root.preview_lang;
        preview_text: root.preview_text;
        preview_file_size: root.preview_file_size;
        preview_file_modified: root.preview_file_modified;
        preview_file_location: root.preview_file_location;
        preview_image: root.preview_image;

        search_text_changed(txt) => {
            root.is_expanded = (txt != "");
            root.search_text_changed(txt);
        }
        item_activated(idx) => {
            root.item_activated(idx);
        }
        move_up() => {
            root.move_up();
        }
        move_down() => {
            root.move_down();
        }
        tab_pressed() => {
            root.tab_pressed();
        }
        backtab_pressed() => {
            root.backtab_pressed();
        }
        right_arrow_pressed => {
            return root.handle_right_arrow();
        }
        left_arrow_pressed => {
            return root.handle_left_arrow();
        }
        backspace_pressed => {
            return root.handle_backspace();
        }
        close_launcher() => {
            root.close_window();
        }
        open_settings() => {
            root.open_config();
        }
        start_window_drag() => {
            root.start_window_drag();
        }
        chip_selected(cat) => {
            root.is_expanded = true;
            root.chip_selected(cat);
        }
        active_scope <=> root.active_scope;
        scope_apps_icon: root.scope_apps_icon;
        scope_files_icon: root.scope_files_icon;
        scope_text_icon: root.scope_text_icon;
        scope_windows_icon: root.scope_windows_icon;
        action_hint_text: root.action_hint_text;
        action_item_count: root.action_item_count;
        cfg_show_status_bar: root.cfg_show_status_bar;
        scope_selected(sc) => {
            root.scope_selected(sc);
        }
        f1_pressed => {
            root.set_search_text_and_search("?");
        }
        copy_item(idx) => {
            root.copy_item(idx);
        }
        copy_path(idx) => {
            root.copy_path(idx);
        }
    }

    // Main Container (Fuzzel Aesthetic)
    main_card := Rectangle {
        visible: (root.cfg_view_style != "liquid_glass") || root.in_settings_mode;
        x: 0px;
        y: 0px;
        opacity: root.is_pop_visible ? 1.0 : 0.0;
        animate opacity { duration: root.is_pop_visible ? 160ms : 0ms; easing: ease-out; }
        width: 100%;
        height: root.content_height;
        background: root.col_card_bg;
        border-radius: root.launcher_radius;
        animate border-radius { duration: Theme.anim_expand; easing: cubic-bezier(0.2, 0.8, 0.2, 1.0); }
        border-width: 1px;
        border-color: root.col_border;
        animate border-color { duration: 150ms; easing: ease-out; }
        clip: true;

        // =========================================================
        // VIEW 1: FUZZEL LAUNCHER VIEW
        // =========================================================
        search_view := VerticalLayout {
            visible: !root.in_settings_mode;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 0px;
            padding-bottom: 0px;
            spacing: 4px;

            // 1. TOP FUZZEL SEARCH BAR (🔍 ❯ cursor + Settings Button)
            search_box := Rectangle {
                height: Theme.panel_header_height;
                background: transparent;

                // Top drag region
                drag_region := TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.start_window_drag();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 18px;
                    spacing: 8px;

                    // 1.1 Fuzzel Search Icon (stroke=#dedcd1)
                    VerticalLayout {
                        alignment: center;
                        width: 18px;
                        Image {
                            source: root.search_icon;
                            colorize: root.col_prompt;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // 1.2 Fuzzel Prompt Chevron (❯)
                    Text {
                        text: "❯";
                        color: root.col_prompt;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // 1.3 Text Input
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if (root.search_text == "") : Text {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text: "Search";
                            font-size: 16px;
                            font-weight: 400;
                            color: root.col_text_placeholder;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }

                        search_input := TextInput {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search_text;
                            single-line: true;
                            font-size: 19px;
                            color: root.col_input_text;
                            selection-background-color: root.col_selection_bg;
                            selection-foreground-color: root.col_selection_text;
                            vertical-alignment: center;
                            horizontal-alignment: left;

                            edited => {
                                root.shell_history_reset();
                                root.is_expanded = (self.text != "");
                                root.search_text_changed(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.F1) {
                                    root.set_search_text_and_search("?");
                                    root.move_cursor_to_end();
                                    return accept;
                                }
                                if (event.text == Key.Tab) {
                                    root.tab_pressed();
                                    root.move_cursor_to_end();
                                    return accept;
                                }
                                if (event.text == Key.Backtab) {
                                    root.backtab_pressed();
                                    root.move_cursor_to_end();
                                    return accept;
                                }
                                if (event.text == Key.RightArrow) {
                                    if (root.handle_right_arrow()) {
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                }
                                if (event.text == Key.LeftArrow) {
                                    if (root.handle_left_arrow()) {
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                }
                                if (event.text == Key.Backspace) {
                                    if (root.handle_backspace()) {
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                }
                                if (event.text == Key.Escape || event.text == "\u{001b}") {
                                    root.close_window();
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.item_activated(root.selected_index);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    if (root.is_shell_mode) {
                                        root.set_search_text_and_search(root.shell_history_next());
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                    if (root.cfg_compact_empty && root.search_text == "" && !root.is_expanded) {
                                        root.is_expanded = true;
                                        return accept;
                                    }
                                    root.move_down();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    if (root.is_shell_mode) {
                                        root.set_search_text_and_search(root.shell_history_prev());
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                    if (root.cfg_compact_empty && root.search_text == "" && root.selected_index == 0 && root.is_expanded) {
                                        root.is_expanded = false;
                                        return accept;
                                    }
                                    root.move_up();
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == ",") {
                                    root.open_config();
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "t" || event.text == "T")) {
                                    root.open_in_terminal(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.control && event.modifiers.shift && (event.text == "c" || event.text == "C")) {
                                    root.copy_path(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                    root.copy_path(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                                    if (self.cursor-position_byte-offset == self.anchor-position-byte-offset) {
                                        root.copy_item(root.selected_index);
                                        return accept;
                                    }
                                }
                                return reject;
                            }
                        }
                    }

                    // 1.4 Mode indicator badge (only if in a specialized mode like !shell or dmenu)
                    if (root.mode_badge_text != "") : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            background: root.col_selection_bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: root.mode_badge_text;
                                    color: root.col_prompt;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 1.5 Settings Button (⚙ Gear icon on the right end)
                    VerticalLayout {
                        alignment: center;
                        settings_btn := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: settings_touch.has-hover ? root.col_selection_bg : transparent;
                            animate background { duration: 100ms; }

                            settings_touch := TouchArea {
                                clicked => {
                                    root.open_config();
                                }
                            }

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.settings_icon;
                                colorize: root.col_prompt;
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                opacity: settings_touch.has-hover ? 1.0 : 0.7;
                                animate opacity { duration: 100ms; }
                            }
                        }
                    }
                }
            }

            // Scope Filter Chips in Classic Mode
            if (root.is_showing_list && !root.in_settings_mode) : Rectangle {
                height: Theme.chips_height;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: start;
                    spacing: 8px;

                    CategoryChip {
                        icon: root.scope_apps_icon;
                        has_icon: true;
                        text: "Apps";
                        active: root.active_scope == "apps";
                        clicked => { root.scope_selected("apps"); }
                    }
                    CategoryChip {
                        icon: root.scope_files_icon;
                        has_icon: true;
                        text: "Files";
                        active: root.active_scope == "files";
                        clicked => { root.scope_selected("files"); }
                    }
                    CategoryChip {
                        icon: root.scope_text_icon;
                        has_icon: true;
                        text: "Text";
                        active: root.active_scope == "text";
                        clicked => { root.scope_selected("text"); }
                    }
                    CategoryChip {
                        icon: root.scope_windows_icon;
                        has_icon: true;
                        text: "Windows";
                        active: root.active_scope == "windows";
                        clicked => { root.scope_selected("windows"); }
                    }
                }
            }

            // 2. SCROLLABLE RESULTS LIST (Fuzzel Item Selection Style)
            list_container := Rectangle {
                visible: root.is_showing_list;
                vertical-stretch: 1;
                clip: true;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;

                    // 2.1 Empty State
                    if (!root.has_results) : Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: root.is_empty_folder ? root.folder_icon : root.search_icon;
                                    width: 32px;
                                    height: 32px;
                                    image-fit: contain;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.empty_state_title;
                                font-size: 14px;
                                font-weight: 600;
                                color: root.col_text_primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.empty_state_subtitle;
                                font-size: 12px;
                                color: root.col_text_muted;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // 2.2 Scrollable Results
                    list_flickable := Flickable {
                        visible: root.has_results;
                        horizontal-stretch: 1;
                        viewport-y <=> root.scroll_viewport_y;
                        viewport-height: Math.max(self.height, root.items.length * 44px);

                        VerticalLayout {
                            spacing: 0px;
                            alignment: start;

                            for item[index] in root.items : item_row := Rectangle {
                                height: 44px;
                                background: (index == root.selected_index) ? root.col_selection_bg : (item_touch.has-hover ? root.col_item_hover : transparent);
                                border-radius: 0px;
                                animate background { duration: 60ms; }

                                item_touch := TouchArea {
                                    clicked => {
                                        root.selected_index = index;
                                        root.item_activated(index);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 0px;
                                    padding-bottom: 0px;
                                    spacing: 14px;

                                    // Perfectly Vertically-Centered 32px Icon Container
                                    VerticalLayout {
                                        alignment: center;
                                        width: 32px;

                                        HorizontalLayout {
                                            alignment: center;

                                            // Real system icon
                                            if (root.cfg_show_icons && item.has_icon) : Image {
                                                source: item.icon;
                                                width: 32px;
                                                height: 32px;
                                                image-fit: contain;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            // Fallback text/glyph icon
                                            if (!root.cfg_show_icons || !item.has_icon) : Rectangle {
                                                width: 30px;
                                                height: 30px;
                                                border-radius: 6px;
                                                background: root.col_badge_bg;

                                                Text {
                                                    width: 100%;
                                                    height: 100%;
                                                    text: (item.item_type == "calc") ? "=" : ((item.item_type == "dir") ? "/" : ((item.item_type == "clip") ? "≡" : ((item.item_type == "win") ? "□" : ((item.item_type == "sys") ? "⚙" : ((item.item_type == "theme") ? "◐" : ((item.item_type == "shell") ? "❯" : ((item.item_type == "web") ? "↗" : "◆")))))));
                                                    color: root.col_badge_text;
                                                    font-size: 15px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Item Name Title (Fuzzel Noto Sans 19px) and Subtitle
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: item.name;
                                            color: (index == root.selected_index) ? root.col_selection_text : root.col_text_primary;
                                            font-weight: (index == root.selected_index) ? 600 : 500;
                                            font-size: item.subtitle != "" ? 15px : 19px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        if (item.subtitle != "") : Text {
                                            text: item.subtitle;
                                            color: (index == root.selected_index) ? root.col_selection_text : root.col_text_muted;
                                            font-size: 11px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 2.3 Divider between results and preview
                    if (root.show_preview && root.has_results) : Rectangle {
                        width: 1px;
                        background: root.col_border;
                    }

                    // 2.4 Preview Panel (Classic / Fuzzel Theme)
                    if (root.show_preview && root.has_results) : Rectangle {
                        width: Theme.preview_pane_width;
                        background: root.col_card_bg;
                        clip: true;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            // Preview Title
                            Text {
                                text: root.preview_title;
                                font-size: 16px;
                                font-weight: 700;
                                color: root.col_text_primary;
                                overflow: elide;
                            }

                            if (root.preview_file_location != "") : Text {
                                text: root.preview_file_location;
                                font-size: 12px;
                                color: root.col_text_muted;
                                overflow: elide;
                            }

                            Rectangle {
                                height: 1px;
                                background: root.col_border;
                            }

                            // 1. Image Preview
                            if (root.preview_type == "image") : Rectangle {
                                vertical-stretch: 1;
                                background: rgba(0, 0, 0, 0.2);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.col_border;
                                clip: true;
                                VerticalLayout {
                                    alignment: center;
                                    padding: 8px;
                                    Image {
                                        source: root.preview_image;
                                        max-width: 500px;
                                        max-height: 380px;
                                        image-fit: contain;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 2. Text Snippet Preview
                            if (root.preview_type == "text") : Rectangle {
                                vertical-stretch: 1;
                                background: rgba(0, 0, 0, 0.25);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.col_border;
                                clip: true;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 8px;
                                    alignment: start;

                                    if (root.preview_lang != "") : HorizontalLayout {
                                        alignment: end;
                                        Rectangle {
                                            background: rgba(255, 255, 255, 0.1);
                                            border-radius: 4px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                padding-top: 3px;
                                                padding-bottom: 3px;
                                                Text {
                                                    text: root.preview_lang;
                                                    font-family: "monospace";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: root.col_prompt;
                                                }
                                            }
                                        }
                                    }

                                    Flickable {
                                        vertical-stretch: 1;
                                        interactive: true;
                                        viewport-height: classic_preview_layout.preferred-height;

                                        classic_preview_layout := VerticalLayout {
                                            x: 0px;
                                            y: 0px;
                                            width: 100%;
                                            alignment: start;

                                            Text {
                                                text: root.preview_text;
                                                font-family: "monospace";
                                                font-size: 13.5px;
                                                color: root.col_text_primary;
                                                wrap: word-wrap;
                                                horizontal-alignment: left;
                                            }
                                        }
                                    }
                                }
                            }

                            // 3. Metadata Preview Card
                            if (root.preview_type == "metadata") : Rectangle {
                                vertical-stretch: 1;
                                background: rgba(0, 0, 0, 0.15);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.col_border;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    padding: 20px;

                                    Text {
                                        text: root.preview_lang != "" ? root.preview_lang : "FILE";
                                        font-size: 18px;
                                        font-weight: 700;
                                        color: root.col_prompt;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.preview_file_size;
                                        font-size: 13px;
                                        color: root.col_text_muted;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: root.col_border;
                            }

                            // Bottom info bar
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: root.preview_file_size;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: root.col_prompt;
                                }
                                Text {
                                    text: root.preview_file_modified;
                                    font-size: 12px;
                                    color: root.col_text_muted;
                                }
                            }
                        }
                    }
                }
            }

            // Action Footer Bar in Classic Mode
            if (root.is_showing_list && root.cfg_show_status_bar && !root.in_settings_mode) : Rectangle {
                height: 28px;
                background: transparent;

                Rectangle {
                    x: 20px;
                    y: 0px;
                    width: parent.width - 40px;
                    height: 1px;
                    background: root.col_border;
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    Text {
                        text: root.action_hint_text;
                        font-size: 11px;
                        color: root.col_text_muted;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.action_item_count;
                        font-size: 11px;
                        color: root.col_text_muted;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // =========================================================
        // VIEW 2: SPOTLIGHT PREFERENCES VIEW
        // =========================================================
        settings_view := Rectangle {
            visible: root.in_settings_mode;
            width: 100%;
            height: 100%;

            settings_focus := FocusScope {
                width: 100%;
                height: 100%;

                key-pressed(event) => {
                    if (event.text == Key.Escape || event.text == "\u{001b}") {
                        root.auto_save_settings();
                        root.close_settings();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 16px;
                    spacing: 10px;

                    // 0. Settings Header Bar (26px)
                    settings_title_bar := Rectangle {
                        height: 26px;

                        settings_drag_region := TouchArea {
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.start_window_drag();
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                HorizontalLayout {
                                    alignment: center;
                                    width: 18px;
                                    Image {
                                        source: root.settings_icon;
                                        colorize: root.col_prompt;
                                        width: 16px;
                                        height: 16px;
                                        image-fit: contain;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                                Text {
                                    text: "Spotlight Preferences";
                                    color: root.col_text_primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Back Button [Esc]
                            back_btn := Rectangle {
                                height: 26px;
                                background: back_touch.has-hover ? root.col_btn_secondary_hover : root.col_btn_secondary_bg;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.col_settings_card_border;

                                back_touch := TouchArea {
                                    clicked => {
                                        root.auto_save_settings();
                                        root.close_settings();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "← Back [Esc]";
                                        color: root.col_btn_secondary_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: root.col_separator; }

                    // 1. Settings Scrollable Content Area
                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: 480px;

                        VerticalLayout {
                            padding-right: 6px;
                            spacing: 7px;

                            // Group 0: System & Startup
                            Text {
                                text: "SYSTEM & STARTUP";
                                color: root.col_kbd_accent;
                                font-size: 11px;
                                font-weight: 700;
                            }

                            // Setting: Autostart with System
                            Rectangle {
                                height: 36px;
                                background: root.col_settings_card_bg;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: root.col_settings_card_border;
                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: space-between;
                                    Text {
                                        text: "Start Automatically on System Boot";
                                        color: root.col_settings_card_text;
                                        font-size: 13px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        toggle_autostart := Rectangle {
                                            width: 48px;
                                            height: 22px;
                                            border-radius: 11px;
                                            background: root.cfg_autostart ? #34c759 : #3a3a3c;
                                            TouchArea {
                                                clicked => {
                                                    root.cfg_autostart = !root.cfg_autostart;
                                                    root.auto_save_settings();
                                                }
                                            }
                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: root.cfg_autostart ? "ON" : "OFF";
                                                color: root.cfg_autostart ? #ffffff : #8e8e93;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                        // Group 1: Appearance & Theme
                        Text {
                            text: "APPEARANCE & THEME";
                            color: root.col_kbd_accent;
                            font-size: 11px;
                            font-weight: 700;
                        }

                        // Setting: Theme Mode (Dark / Light / System)
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Theme Palette";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 176px;
                                        height: 26px;
                                        background: root.col_kbd_bg;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.col_settings_card_border;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;

                                            // Dark
                                            Rectangle {
                                                width: 56px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_mode == "dark") ? #007aff : transparent;
                                                TouchArea {
                                                    clicked => {
                                                        root.cfg_theme_mode = "dark";
                                                        root.is_dark = true;
                                                        root.auto_save_settings();
                                                    }
                                                }
                                                Text {
                                                    text: "Dark";
                                                    color: (root.cfg_theme_mode == "dark") ? #ffffff : root.col_text_muted;
                                                    font-size: 11px;
                                                    font-weight: (root.cfg_theme_mode == "dark") ? 700 : 500;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }

                                            // Light
                                            Rectangle {
                                                width: 56px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_mode == "light") ? #007aff : transparent;
                                                TouchArea {
                                                    clicked => {
                                                        root.cfg_theme_mode = "light";
                                                        root.is_dark = false;
                                                        root.auto_save_settings();
                                                    }
                                                }
                                                Text {
                                                    text: "Light";
                                                    color: (root.cfg_theme_mode == "light") ? #ffffff : root.col_text_muted;
                                                    font-size: 11px;
                                                    font-weight: (root.cfg_theme_mode == "light") ? 700 : 500;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }

                                            // System
                                            Rectangle {
                                                width: 56px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_mode == "system") ? #007aff : transparent;
                                                TouchArea {
                                                    clicked => {
                                                        root.cfg_theme_mode = "system";
                                                        root.request_system_theme();
                                                        root.auto_save_settings();
                                                    }
                                                }
                                                Text {
                                                    text: "System";
                                                    color: (root.cfg_theme_mode == "system") ? #ffffff : root.col_text_muted;
                                                    font-size: 11px;
                                                    font-weight: (root.cfg_theme_mode == "system") ? 700 : 500;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Setting: Window Opacity Selector
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Window Opacity (Glassmorphism)";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 222px;
                                        height: 26px;
                                        background: root.col_kbd_bg;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.col_settings_card_border;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;

                                            // 100%
                                            Rectangle {
                                                width: 42px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_opacity >= 0.98) ? #007aff : transparent;
                                                TouchArea { clicked => { root.cfg_theme_opacity = 1.0; root.auto_save_settings(); } }
                                                Text { text: "100%"; color: (root.cfg_theme_opacity >= 0.98) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.98) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                            }

                                            // 95%
                                            Rectangle {
                                                width: 42px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_opacity >= 0.93 && root.cfg_theme_opacity < 0.98) ? #007aff : transparent;
                                                TouchArea { clicked => { root.cfg_theme_opacity = 0.95; root.auto_save_settings(); } }
                                                Text { text: "95%"; color: (root.cfg_theme_opacity >= 0.93 && root.cfg_theme_opacity < 0.98) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.93 && root.cfg_theme_opacity < 0.98) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                            }

                                            // 90%
                                            Rectangle {
                                                width: 42px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_opacity >= 0.86 && root.cfg_theme_opacity < 0.93) ? #007aff : transparent;
                                                TouchArea { clicked => { root.cfg_theme_opacity = 0.90; root.auto_save_settings(); } }
                                                Text { text: "90%"; color: (root.cfg_theme_opacity >= 0.86 && root.cfg_theme_opacity < 0.93) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.86 && root.cfg_theme_opacity < 0.93) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                            }

                                            // 80%
                                            Rectangle {
                                                width: 42px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_opacity >= 0.76 && root.cfg_theme_opacity < 0.86) ? #007aff : transparent;
                                                TouchArea { clicked => { root.cfg_theme_opacity = 0.80; root.auto_save_settings(); } }
                                                Text { text: "80%"; color: (root.cfg_theme_opacity >= 0.76 && root.cfg_theme_opacity < 0.86) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.76 && root.cfg_theme_opacity < 0.86) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                            }

                                            // 70%
                                            Rectangle {
                                                width: 42px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_theme_opacity < 0.76) ? #007aff : transparent;
                                                TouchArea { clicked => { root.cfg_theme_opacity = 0.70; root.auto_save_settings(); } }
                                                Text { text: "70%"; color: (root.cfg_theme_opacity < 0.76) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity < 0.76) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Setting: Show App Icons
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Show Native Application Icons";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    toggle_icon := Rectangle {
                                        width: 48px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: root.cfg_show_icons ? #34c759 : #3a3a3c;
                                        TouchArea {
                                            clicked => {
                                                root.cfg_show_icons = !root.cfg_show_icons;
                                                root.auto_save_settings();
                                            }
                                        }
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: root.cfg_show_icons ? "ON" : "OFF";
                                            color: root.cfg_show_icons ? #ffffff : #8e8e93;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Setting: Compact Start View
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Compact Start View (Spotlight bar)";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    toggle_compact := Rectangle {
                                        width: 48px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: root.cfg_compact_empty ? #34c759 : #3a3a3c;
                                        TouchArea {
                                            clicked => {
                                                root.cfg_compact_empty = !root.cfg_compact_empty;
                                                root.auto_save_settings();
                                            }
                                        }
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: root.cfg_compact_empty ? "ON" : "OFF";
                                            color: root.cfg_compact_empty ? #ffffff : #8e8e93;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Setting: Show Status Bar
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Show Bottom Keyboard Shortcuts Bar";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    toggle_bar := Rectangle {
                                        width: 48px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: root.cfg_show_status_bar ? #34c759 : #3a3a3c;
                                        TouchArea {
                                            clicked => {
                                                root.cfg_show_status_bar = !root.cfg_show_status_bar;
                                                root.auto_save_settings();
                                            }
                                        }
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: root.cfg_show_status_bar ? "ON" : "OFF";
                                            color: root.cfg_show_status_bar ? #ffffff : #8e8e93;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Group 2: Search Engine
                        Text {
                            text: "SEARCH & ENGINE";
                            color: root.col_kbd_accent;
                            font-size: 11px;
                            font-weight: 700;
                        }

                        // Setting: Launcher View Style (Liquid Glass Spotlight vs Classic)
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Launcher Style";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 236px;
                                        height: 26px;
                                        background: root.col_kbd_bg;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.col_settings_card_border;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;

                                            // Liquid Glass (Spotlight)
                                            Rectangle {
                                                width: 140px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_view_style == "liquid_glass") ? #007aff : transparent;
                                                TouchArea {
                                                    clicked => {
                                                        root.cfg_view_style = "liquid_glass";
                                                        root.auto_save_settings();
                                                    }
                                                }
                                                Text {
                                                    text: "Liquid Glass (Spotlight)";
                                                    color: (root.cfg_view_style == "liquid_glass") ? #ffffff : root.col_text_muted;
                                                    font-size: 11px;
                                                    font-weight: (root.cfg_view_style == "liquid_glass") ? 700 : 500;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }

                                            // Classic
                                            Rectangle {
                                                width: 88px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_view_style == "classic") ? #007aff : transparent;
                                                TouchArea {
                                                    clicked => {
                                                        root.cfg_view_style = "classic";
                                                        root.auto_save_settings();
                                                    }
                                                }
                                                Text {
                                                    text: "Classic";
                                                    color: (root.cfg_view_style == "classic") ? #ffffff : root.col_text_muted;
                                                    font-size: 11px;
                                                    font-weight: (root.cfg_view_style == "classic") ? 700 : 500;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Setting: Match Full Path
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Match Full File & Directory Paths";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    toggle_path := Rectangle {
                                        width: 48px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: root.cfg_enable_path_matching ? #34c759 : #3a3a3c;
                                        TouchArea {
                                            clicked => {
                                                root.cfg_enable_path_matching = !root.cfg_enable_path_matching;
                                                root.auto_save_settings();
                                            }
                                        }
                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: root.cfg_enable_path_matching ? "ON" : "OFF";
                                            color: root.cfg_enable_path_matching ? #ffffff : #8e8e93;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Setting: Max Results Selector
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Max Visible Search Results";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 104px;
                                        height: 26px;
                                        background: root.col_kbd_bg;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: root.col_settings_card_border;
                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;

                                            for num in [5, 7, 9] : Rectangle {
                                                width: 32px;
                                                height: 22px;
                                                border-radius: 4px;
                                                background: (root.cfg_max_results == num) ? #007aff : transparent;
                                                TouchArea {
                                                    clicked => {
                                                        root.cfg_max_results = num;
                                                        root.auto_save_settings();
                                                    }
                                                }
                                                Text {
                                                    text: "\{num}";
                                                    color: (root.cfg_max_results == num) ? #ffffff : root.col_text_muted;
                                                    font-size: 11px;
                                                    font-weight: (root.cfg_max_results == num) ? 700 : 500;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }

                    Rectangle { height: 1px; background: root.col_separator; }

                    // 2. Action Buttons & Status Footer
                    HorizontalLayout {
                        height: 30px;
                        alignment: space-between;

                        // Left: Auto-save status / indicator
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text {
                                text: root.settings_status != "" ? root.settings_status : "✔ Auto-saves all changes";
                                color: root.settings_status != "" ? #34c759 : root.col_text_muted;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }

                        // Right: Action buttons
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            // Button: Open Raw config.toml
                            raw_btn := Rectangle {
                                background: raw_touch.has-hover ? root.col_btn_secondary_hover : root.col_btn_secondary_bg;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.col_settings_card_border;

                                raw_touch := TouchArea {
                                    clicked => {
                                        root.open_raw_config();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "Edit config.toml";
                                        color: root.col_btn_secondary_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Button: Done [Esc]
                            done_btn := Rectangle {
                                background: done_touch.has-hover ? #0062d2 : #007aff;
                                border-radius: 6px;

                                done_touch := TouchArea {
                                    clicked => {
                                        root.auto_save_settings();
                                        root.close_settings();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: center;
                                    Text {
                                        text: "Done [Esc]";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}
