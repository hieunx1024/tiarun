import { Theme } from "theme.slint";
import { CategoryChip } from "components/chip.slint";
import { PreviewPane } from "components/preview_pane.slint";
import { SettingsView } from "components/settings_view.slint";

export struct LauncherItemData {
    name: string,
    category: string,
    item_type: string,
    has_icon: bool,
    icon: image,
    exec_or_path: string,
    subtitle: string,
    cpu_text: string,
    ram_text: string,
}

export { Theme }

export component AppWindow inherits Window {
    forward-focus: window_focus;
    title: "TiaRun";
    icon: @image-url("../assets/tiarun.png");
    no-frame: true;
    background: transparent;
    width: root.launcher_width;
    height: root.launcher_height;
    in-out property <bool> cfg_fixed_width: false;
    property <length> content_height: root.in_settings_mode ? Theme.settings_height :
        (root.is_showing_list ? Theme.panel_height : Theme.pill_height);
    property <length> panel_base_width: root.cfg_fixed_width ? Theme.panel_width :
        ((root.is_showing_list && !root.in_settings_mode) ? Theme.panel_width : Theme.pill_width);
    out property <length> launcher_width: root.panel_base_width;
    out property <length> launcher_height: root.cfg_fixed_width ? Theme.panel_height : root.content_height;
    out property <length> launcher_radius: root.is_showing_list ? Theme.panel_radius : Theme.pill_radius;
    default-font-family: "Noto Sans";
    default-font-size: 19px;

    // File Preview Panel Properties
    in-out property <bool> show_preview: false;
    in property <string> preview_title: "";
    in property <string> preview_type: "none"; // "image" | "text" | "metadata"
    in property <string> preview_lang: "";
    in property <string> preview_text: "";
    in property <string> preview_file_size: "";
    in property <string> preview_file_modified: "";
    in property <string> preview_file_location: "";
    in property <image> preview_image;

    in-out property <string> search_text: "";
    in-out property <int> selected_index: 0;
    in-out property <length> scroll_viewport_y: 0px;
    out property <length> results_height: list_flickable.height;
    out property <bool> has_search_selection: search_input.cursor-position-byte-offset != search_input.anchor-position-byte-offset;
    in property <[LauncherItemData]> items: [];
    in property <bool> has_results: true;
    in property <string> mode_title: "APPLICATIONS";
    in property <bool> is_file_mode: false;
    in property <bool> is_shell_mode: false;
    in property <string> mode_badge_text: "";
    in property <string> status_item_count: "0 apps";

    // Dynamic Morphing Spotlight Properties
    in-out property <bool> cfg_compact_empty: true;
    in-out property <bool> is_expanded: false;
    // Pop-in appear animation: a plain fade in place (no position movement), set by
    // Rust right before/after showing the window. See animate_window_pop_in() in
    // main.rs.
    in-out property <bool> is_pop_visible: false;
    in-out property <bool> is_showing_list: root.in_settings_mode
        || root.search_text != ""
        || root.is_expanded
        || !root.cfg_compact_empty;

    // Action Vector Icons
    in property <image> settings_icon;
    in property <image> nav_icon;
    in property <image> enter_icon;
    in property <image> search_icon;
    in property <image> folder_icon;

    // Empty State Properties
    in property <string> empty_state_title: "No applications found";
    in property <string> empty_state_subtitle: "Try searching for an app, file, or math command";
    in property <bool> is_empty_folder: false;

    // In-App Settings State
    in-out property <bool> in_settings_mode: false;
    in-out property <bool> cfg_autostart: false;
    in-out property <bool> cfg_show_icons: true;
    in-out property <bool> cfg_show_status_bar: true;
    in-out property <bool> cfg_enable_path_matching: true;
    in-out property <int> cfg_max_results: 7;
    in-out property <int> cfg_max_depth: 2;
    in-out property <string> cfg_theme_mode: "dark";
    in-out property <float> cfg_theme_opacity: 0.95;
    in-out property <bool> is_dark: false;
    in-out property <string> settings_status: "";
    in-out property <string> active_scope: "apps";
    in property <image> scope_apps_icon;
    in property <image> scope_files_icon;
    in property <image> scope_windows_icon;
    in property <string> action_hint_text: "";
    in property <string> action_item_count: "";

    // Dynamic Theme Color Tokens (Fuzzel Theme)
    property <color> col_card_bg: root.is_dark ? rgba(28, 28, 28, root.cfg_theme_opacity) : rgba(250, 250, 252, root.cfg_theme_opacity);
    property <color> col_border: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_text_primary: root.is_dark ? #c2c0b6 : #1d1d1f;
    property <color> col_text_muted: root.is_dark ? #8e8e93 : #86868b;
    property <color> col_text_placeholder: root.is_dark ? #9ca3af : #4b5563;
    property <color> col_input_text: root.is_dark ? #faf9f5 : #1d1d1f;
    property <color> col_selection_bg: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_selection_text: root.is_dark ? #faf9f5 : #1d1d1f;
    property <color> col_prompt: root.is_dark ? #dedcd1 : #48484a;
    property <color> col_item_hover: root.is_dark ? #2d2d2d80 : #f2f2f780;
    property <color> col_accent: root.is_dark ? #dedcd1 : #007aff;
    property <color> col_item_selected_bg: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_badge_bg: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_badge_text: root.is_dark ? #dedcd1 : #48484a;
    property <color> col_separator: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_kbd_bg: root.is_dark ? #2d2d2d : #f2f2f7;
    property <color> col_kbd_border: root.is_dark ? #38383a : #d1d1d6;
    property <color> col_kbd_text: root.is_dark ? #8e8e93 : #86868b;
    property <color> col_kbd_accent: root.is_dark ? #dedcd1 : #007aff;
    property <color> col_settings_card_bg: root.is_dark ? #222222 : #ffffff;
    property <color> col_settings_card_border: root.is_dark ? #2d2d2d : #e5e5ea;
    property <color> col_settings_card_text: root.is_dark ? #faf9f5 : #1d1d1f;
    property <color> col_btn_secondary_bg: root.is_dark ? #2d2d2d : #f2f2f7;
    property <color> col_btn_secondary_hover: root.is_dark ? #383838 : #e5e5ea;
    property <color> col_btn_secondary_text: root.is_dark ? #faf9f5 : #1d1d1f;

    callback search_text_changed(string);
    callback file_search_finished();
    callback window_refresh_finished();
    callback move_up();
    callback move_down();
    callback item_activated(int);
    callback open_in_terminal(int);
    callback copy_path(int);
    callback copy_item(int);
    callback kill_process(int);
    callback open_config();
    callback close_settings();
    callback save_settings(bool, bool, bool, int, int, bool, bool, string, float);
    callback scope_selected(string);
    callback open_raw_config();
    callback close_window();
    callback start_window_drag();
    callback tab_pressed();
    callback backtab_pressed();
    callback handle_backspace() -> bool;
    callback handle_right_arrow() -> bool;
    callback handle_left_arrow() -> bool;
    callback request_system_theme();
    // "!" shell mode command recall (Up/Down), like a real shell's history.
    callback shell_history_prev() -> string;
    callback shell_history_next() -> string;
    callback shell_history_reset();

    public function focus_search() {
        search_input.focus();
    }

    public function move_cursor_to_end() {
        search_input.set-selection-offsets(999999, 999999);
    }

    public function focus_settings() {
        settings_view.focus_settings();
    }

    public function auto_save_settings() {
        root.save_settings(
            root.cfg_show_icons,
            root.cfg_show_status_bar,
            root.cfg_enable_path_matching,
            root.cfg_max_results,
            root.cfg_max_depth,
            root.cfg_autostart,
            root.cfg_compact_empty,
            root.cfg_theme_mode,
            root.cfg_theme_opacity
        );
    }

    // Programmatically sets the search text (shell history recall, F1 help
    // shortcut, ...) and re-runs the search, exactly as if the user had typed it.
    function set_search_text_and_search(text: string) {
        root.search_text = text;
        root.is_expanded = (text != "");
        root.search_text_changed(text);
    }

    init => {
        Theme.dark = root.is_dark;
        search_input.focus();
    }

    changed is_dark => {
        Theme.dark = root.is_dark;
    }

    window_focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == "\u{001b}") {
                if (root.in_settings_mode) {
                    root.auto_save_settings();
                    root.close_settings();
                } else {
                    root.close_window();
                }
                return accept;
            }
            return reject;
        }

    // Transparent click-outside dismiss area when collapsed on fixed-geometry window (GNOME Wayland)
    if (!root.is_showing_list && root.cfg_fixed_width) : TouchArea {
        x: 0px;
        y: root.content_height;
        width: 100%;
        height: Math.max(0px, root.launcher_height - root.content_height);
        clicked => {
            root.close_window();
        }
    }

    // Main Container (Fuzzel Aesthetic)
    main_card := Rectangle {
        x: 0px;
        y: 0px;
        opacity: root.is_pop_visible ? 1.0 : 0.0;
        animate opacity { duration: root.is_pop_visible ? 110ms : 0ms; easing: ease-out; }
        width: 100%;
        height: root.content_height;
        background: root.col_card_bg;
        border-radius: root.launcher_radius;
        border-width: 1px;
        border-color: root.col_border;
        clip: true;

        // =========================================================
        // VIEW 1: FUZZEL LAUNCHER VIEW
        // =========================================================
        search_view := VerticalLayout {
            visible: !root.in_settings_mode;
            padding-left: 0px;
            padding-right: 0px;
            padding-top: 0px;
            padding-bottom: 0px;
            spacing: 4px;

            // 1. TOP FUZZEL SEARCH BAR (🔍 ❯ cursor + Settings Button)
            search_box := Rectangle {
                height: Theme.panel_header_height;
                background: transparent;

                // Top drag region
                drag_region := TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.start_window_drag();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 18px;
                    spacing: 8px;

                    // 1.1 Fuzzel Search Icon (stroke=#dedcd1)
                    VerticalLayout {
                        alignment: center;
                        width: 18px;
                        Image {
                            source: root.search_icon;
                            colorize: root.col_prompt;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // 1.2 Fuzzel Prompt Chevron (❯)
                    Text {
                        text: "❯";
                        color: root.col_prompt;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // 1.3 Text Input
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if (root.search_text == "") : Text {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text: "Search";
                            font-size: 16px;
                            font-weight: 400;
                            color: root.col_text_placeholder;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }

                        search_input := TextInput {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search_text;
                            single-line: true;
                            font-size: 19px;
                            color: root.col_input_text;
                            selection-background-color: root.col_selection_bg;
                            selection-foreground-color: root.col_selection_text;
                            vertical-alignment: center;
                            horizontal-alignment: left;

                            edited => {
                                root.shell_history_reset();
                                root.is_expanded = (self.text != "");
                                root.search_text_changed(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.F1) {
                                    root.set_search_text_and_search("?");
                                    root.move_cursor_to_end();
                                    return accept;
                                }
                                if (event.text == Key.Tab) {
                                    root.tab_pressed();
                                    root.move_cursor_to_end();
                                    return accept;
                                }
                                if (event.text == Key.Backtab) {
                                    root.backtab_pressed();
                                    root.move_cursor_to_end();
                                    return accept;
                                }
                                if (event.text == Key.RightArrow) {
                                    if (root.handle_right_arrow()) {
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                }
                                if (event.text == Key.LeftArrow) {
                                    if (root.handle_left_arrow()) {
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                }
                                if (event.text == Key.Backspace) {
                                    if (root.handle_backspace()) {
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                }
                                if (event.text == Key.Escape || event.text == "\u{001b}") {
                                    root.close_window();
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.item_activated(root.selected_index);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    if (root.is_shell_mode) {
                                        root.set_search_text_and_search(root.shell_history_next());
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                    if (root.cfg_compact_empty && root.search_text == "" && !root.is_expanded) {
                                        root.is_expanded = true;
                                        return accept;
                                    }
                                    root.move_down();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    if (root.is_shell_mode) {
                                        root.set_search_text_and_search(root.shell_history_prev());
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                    if (root.cfg_compact_empty && root.search_text == "" && root.selected_index == 0 && root.is_expanded) {
                                        root.is_expanded = false;
                                        return accept;
                                    }
                                    root.move_up();
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == ",") {
                                    root.open_config();
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "t" || event.text == "T")) {
                                    root.open_in_terminal(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.control && event.modifiers.shift && (event.text == "c" || event.text == "C")) {
                                    root.copy_path(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                    root.copy_path(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                                    if (self.cursor-position_byte-offset == self.anchor-position-byte-offset) {
                                        root.copy_item(root.selected_index);
                                        return accept;
                                    }
                                }
                                if (event.modifiers.alt && (event.text == "k" || event.text == "K")) {
                                    if (root.active_scope == "windows") {
                                        root.kill_process(root.selected_index);
                                        return accept;
                                    }
                                }
                                return reject;
                            }
                        }
                    }

                    // 1.4 Mode indicator badge (only if in a specialized mode like !shell or dmenu)
                    if (root.mode_badge_text != "") : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            background: root.col_selection_bg;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: root.mode_badge_text;
                                    color: root.col_prompt;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // 1.5 Help Keycap (F1 / ?) & Settings Button (⚙) on the right end
                    VerticalLayout {
                        alignment: center;
                        help_btn := Rectangle {
                            width: 26px;
                            height: 22px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: (root.search_text == "?" || help_touch.has-hover) ? root.col_prompt : root.col_kbd_border;
                            background: (root.search_text == "?" || help_touch.has-hover) ? root.col_selection_bg : root.col_kbd_bg;
                            animate background { duration: 100ms; }

                            help_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (root.search_text == "?") {
                                        root.set_search_text_and_search("");
                                    } else {
                                        root.set_search_text_and_search("?");
                                    }
                                    root.focus_search();
                                    root.move_cursor_to_end();
                                }
                            }

                            Text {
                                width: 100%;
                                height: 100%;
                                text: "F1";
                                color: (root.search_text == "?" || help_touch.has-hover) ? root.col_selection_text : root.col_kbd_text;
                                font-size: 10px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        settings_btn := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: settings_touch.has-hover ? root.col_selection_bg : transparent;
                            animate background { duration: 100ms; }

                            settings_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open_config();
                                }
                            }

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.settings_icon;
                                colorize: root.col_prompt;
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                                opacity: settings_touch.has-hover ? 1.0 : 0.7;
                                animate opacity { duration: 100ms; }
                            }
                        }
                    }
                }
            }

            // Scope Filter Chips in Classic Mode
            if (root.is_showing_list && !root.in_settings_mode) : Rectangle {
                height: Theme.chips_height;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: start;
                    spacing: 8px;

                    CategoryChip {
                        icon: root.scope_apps_icon;
                        has_icon: true;
                        text: "Apps";
                        active: root.active_scope == "apps";
                        clicked => { root.scope_selected("apps"); }
                    }
                    CategoryChip {
                        icon: root.scope_files_icon;
                        has_icon: true;
                        text: "Files";
                        active: root.active_scope == "files";
                        clicked => { root.scope_selected("files"); }
                    }
                    CategoryChip {
                        icon: root.scope_windows_icon;
                        has_icon: true;
                        text: "Windows";
                        active: root.active_scope == "windows";
                        clicked => { root.scope_selected("windows"); }
                    }
                }
            }

            // 2. SCROLLABLE RESULTS LIST (Fuzzel Item Selection Style)
            list_container := Rectangle {
                visible: root.is_showing_list;
                vertical-stretch: 1;
                clip: true;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;

                    // 2.1 Empty State
                    if (!root.has_results) : Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: root.is_empty_folder ? root.folder_icon : root.search_icon;
                                    width: 32px;
                                    height: 32px;
                                    image-fit: contain;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.empty_state_title;
                                font-size: 14px;
                                font-weight: 600;
                                color: root.col_text_primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.empty_state_subtitle;
                                font-size: 12px;
                                color: root.col_text_muted;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // 2.2 Scrollable Results
                    list_flickable := Flickable {
                        visible: root.has_results;
                        horizontal-stretch: 1;
                        viewport-y <=> root.scroll_viewport_y;
                        viewport-height: Math.max(self.height, root.items.length * 44px);

                        VerticalLayout {
                            spacing: 0px;
                            alignment: start;

                            for item[index] in root.items : item_row := Rectangle {
                                height: 44px;
                                background: (index == root.selected_index) ? root.col_selection_bg : (item_touch.has-hover ? root.col_item_hover : transparent);
                                border-radius: 0px;

                                item_touch := TouchArea {
                                    clicked => {
                                        root.selected_index = index;
                                        root.item_activated(index);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 0px;
                                    padding-bottom: 0px;
                                    spacing: 14px;

                                    // Perfectly Vertically-Centered 32px Icon Container
                                    VerticalLayout {
                                        alignment: center;
                                        width: 32px;

                                        HorizontalLayout {
                                            alignment: center;

                                            // Real system icon
                                            if (root.cfg_show_icons && item.has_icon) : Image {
                                                source: item.icon;
                                                width: 32px;
                                                height: 32px;
                                                image-fit: contain;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            // Fallback text/glyph icon
                                            if (!root.cfg_show_icons || !item.has_icon) : Rectangle {
                                                width: 30px;
                                                height: 30px;
                                                border-radius: 6px;
                                                background: root.col_badge_bg;

                                                Text {
                                                    width: 100%;
                                                    height: 100%;
                                                    text: (item.item_type == "calc") ? "=" : ((item.item_type == "dir") ? "/" : ((item.item_type == "clip") ? "≡" : ((item.item_type == "win") ? "□" : ((item.item_type == "sys") ? "⚙" : ((item.item_type == "theme") ? "◐" : ((item.item_type == "shell") ? "❯" : ((item.item_type == "mode") ? "@" : ((item.item_type == "web") ? "↗" : "◆"))))))));
                                                    color: root.col_badge_text;
                                                    font-size: 15px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Item Name Title (Fuzzel Noto Sans 19px) and Subtitle
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: item.name;
                                            color: (index == root.selected_index) ? root.col_selection_text : root.col_text_primary;
                                            font-weight: (index == root.selected_index) ? 600 : 500;
                                            font-size: item.subtitle != "" ? 15px : 19px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        if (item.subtitle != "") : Text {
                                            text: item.subtitle;
                                            color: (index == root.selected_index) ? root.col_selection_text : root.col_text_muted;
                                            font-size: 11px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Process Metrics (CPU% & RAM) in @w Window Switcher
                                    if (item.cpu_text != "" || item.ram_text != "") : VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: end;

                                            if (item.cpu_text != "") : Rectangle {
                                                height: 22px;
                                                border-radius: 5px;
                                                background: (index == root.selected_index) ? root.col_card_bg : root.col_badge_bg;
                                                border-width: 1px;
                                                border-color: root.col_border;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    alignment: center;
                                                    Text {
                                                        text: item.cpu_text;
                                                        color: (index == root.selected_index) ? root.col_selection_text : root.col_text_primary;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            if (item.ram_text != "") : Rectangle {
                                                height: 22px;
                                                border-radius: 5px;
                                                background: (index == root.selected_index) ? root.col_card_bg : root.col_badge_bg;
                                                border-width: 1px;
                                                border-color: root.col_border;
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    alignment: center;
                                                    Text {
                                                        text: item.ram_text;
                                                        color: (index == root.selected_index) ? root.col_selection_text : root.col_text_primary;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 2.3 Divider between results and preview
                    if (root.show_preview && root.has_results) : Rectangle {
                        width: 1px;
                        background: root.col_border;
                    }

                    // 2.4 Preview Panel (Classic / Fuzzel Theme)
                    if (root.show_preview && root.has_results) : PreviewPane {
                        preview_title: root.preview_title;
                        preview_type: root.preview_type;
                        preview_lang: root.preview_lang;
                        preview_text: root.preview_text;
                        preview_file_size: root.preview_file_size;
                        preview_file_modified: root.preview_file_modified;
                        preview_file_location: root.preview_file_location;
                        preview_image: root.preview_image;
                        col_card_bg: root.col_card_bg;
                        col_border: root.col_border;
                        col_text_primary: root.col_text_primary;
                        col_text_muted: root.col_text_muted;
                        col_prompt: root.col_prompt;
                    }
                }
            }

            // Action Footer Bar in Classic Mode
            if (root.is_showing_list && root.cfg_show_status_bar && !root.in_settings_mode) : Rectangle {
                height: 28px;
                background: transparent;

                Rectangle {
                    x: 20px;
                    y: 0px;
                    width: parent.width - 40px;
                    height: 1px;
                    background: root.col_border;
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 20px;
                    padding-right: 20px;
                    alignment: space-between;

                    Text {
                        text: root.action_hint_text;
                        font-size: 11px;
                        color: root.col_text_muted;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.action_item_count;
                        font-size: 11px;
                        color: root.col_text_muted;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // =========================================================
        // VIEW 2: SPOTLIGHT PREFERENCES VIEW
        // =========================================================
        settings_view := SettingsView {
            visible: root.in_settings_mode;
            width: 100%;
            height: 100%;
            settings_icon: root.settings_icon;
            is_dark <=> root.is_dark;
            cfg_autostart <=> root.cfg_autostart;
            cfg_show_icons <=> root.cfg_show_icons;
            cfg_show_status_bar <=> root.cfg_show_status_bar;
            cfg_enable_path_matching <=> root.cfg_enable_path_matching;
            cfg_compact_empty <=> root.cfg_compact_empty;
            cfg_max_results <=> root.cfg_max_results;
            cfg_theme_mode <=> root.cfg_theme_mode;
            cfg_theme_opacity <=> root.cfg_theme_opacity;
            settings_status: root.settings_status;
            col_prompt: root.col_prompt;
            col_text_primary: root.col_text_primary;
            col_text_muted: root.col_text_muted;
            col_btn_secondary_hover: root.col_btn_secondary_hover;
            col_btn_secondary_bg: root.col_btn_secondary_bg;
            col_btn_secondary_text: root.col_btn_secondary_text;
            col_settings_card_bg: root.col_settings_card_bg;
            col_settings_card_border: root.col_settings_card_border;
            col_settings_card_text: root.col_settings_card_text;
            col_separator: root.col_separator;
            col_kbd_accent: root.col_kbd_accent;
            col_kbd_bg: root.col_kbd_bg;
            auto_save_settings => { root.auto_save_settings(); }
            close_settings => { root.close_settings(); }
            start_window_drag => { root.start_window_drag(); }
            request_system_theme => { root.request_system_theme(); }
            open_raw_config => { root.open_raw_config(); }
        }
    }
    }
}
