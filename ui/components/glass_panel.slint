import { Theme } from "../theme.slint";

export component GlassPanel inherits Rectangle {
    in property <length> panel_radius: Theme.pill_radius;

    width: 100%;
    height: 100%;
    border-radius: root.panel_radius;
    border-width: 1px;
    border-color: Theme.glass_outline;
    background: Theme.glass_tint;

    // Keep soft reflections inside the curved outline.
    Rectangle {
        x: root.panel_radius + 8px;
        y: 1px;
        width: Math.min(130px, root.height - 2px);
        height: self.width;
        background: Theme.glass_reflection;
    }

    Rectangle {
        x: root.width - root.panel_radius - self.width;
        y: root.height - self.height - 1px;
        width: Math.min(100px, root.height - 2px);
        height: self.width;
        background: Theme.glass_edge_bounce;
    }
}
