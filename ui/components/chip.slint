import { Theme } from "../theme.slint";

export component CategoryChip inherits Rectangle {
    in property <string> text: "Applications";
    in property <bool> active: false;
    in property <image> icon;
    in property <bool> has_icon: false;
    in property <string> shortcut: "";
    callback clicked();

    height: Theme.chip_height;
    width: chip_layout.preferred-width;
    border-radius: Theme.chip_radius;
    border-width: 0.5px;
    border-color: root.active ? (Theme.dark ? rgba(64, 156, 255, 0.45) : rgba(10, 99, 209, 0.35)) : Theme.chip_border;
    background: root.active ? (Theme.dark ? rgba(10, 132, 255, 0.28) : rgba(10, 132, 255, 0.18)) : (touch.has-hover ? Theme.chip_fill_hover : Theme.chip_fill);

    chip_layout := HorizontalLayout {
        height: 100%;
        padding-left: Theme.chip_padding_x;
        padding-right: Theme.chip_padding_x;
        spacing: 6px;
        alignment: center;

        if (root.has_icon) : VerticalLayout {
            alignment: center;
            width: 13px;

            Image {
                source: root.icon;
                width: 13px;
                height: 13px;
                image-fit: contain;
                colorize: root.active ? Theme.chip_active_text : Theme.chip_text;
            }
        }

        VerticalLayout {
            alignment: center;

            chip_txt := Text {
                text: root.text;
                font-family: Theme.font_family;
                font-size: 11.5px;
                font-weight: root.active ? 600 : 500;
                color: root.active ? Theme.chip_active_text : Theme.chip_text;
                vertical-alignment: center;
            }
        }

        if (root.shortcut != "") : VerticalLayout {
            alignment: center;

            Text {
                text: root.shortcut;
                font-family: Theme.font_family;
                font-size: 10.5px;
                font-weight: 500;
                color: root.active ? Theme.chip_active_text : Theme.chip_text;
                opacity: root.active ? 0.8 : 0.55;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
